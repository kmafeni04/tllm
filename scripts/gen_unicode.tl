-- Regenerates src/unicode.tl from the Unicode Character Database.
--
-- Download the two inputs from https://www.unicode.org/Public/<VERSION>/ucd/
-- into the package root, run `lde run gen_unicode`, then `lde run format`.

local VERSION <const> = "16.0.0"
local UNICODE_DATA <const> = "UnicodeData.txt"
local PROP_LIST <const> = "PropList.txt"
local OUTPUT <const> = "src/unicode.tl"

local fs = require("fs")

local function add(ranges: {integer}, first: integer, last: integer)
  local count = #ranges
  if count > 0 and ranges[count] + 1 == first then
    ranges[count] = last
  else
    ranges[count + 1] = first
    ranges[count + 2] = last
  end
end

local letters: {integer} = {}
local numbers: {integer} = {}
local marks: {integer} = {}
local whitespace: {integer} = {}

local function class_ranges(category: string): {integer} | nil
  local initial = category:sub(1, 1)
  if initial == "L" then
    return letters
  elseif initial == "N" then
    return numbers
  elseif initial == "M" then
    return marks
  end
  return nil
end

local function input(path: string): string
  local data = fs.read(path)
  if data == nil then
    error(
      "cannot read "
        .. path
        .. ": download it from https://www.unicode.org/Public/"
        .. VERSION
        .. "/ucd/ into the package root",
      0
    )
  end
  return data as string
end

local unicode_data <const> = input(UNICODE_DATA)
local prop_list <const> = input(PROP_LIST)

local span_first: integer | nil = nil

for line in unicode_data:gmatch("[^\r\n]+") do
  local codepoint, name, category = line:match("^(%x+);([^;]*);([^;]+);")
  if not (codepoint is nil) and not (name is nil) and not (category is nil) then
    local value = tonumber(codepoint, 16) as integer
    local ranges = class_ranges(category)
    if ranges == nil then
      span_first = nil
    elseif name:find(", First>", 1, true) then
      span_first = value
    elseif name:find(", Last>", 1, true) then
      local first = span_first
      if not (first is nil) then
        add(ranges, first, value)
      end
      span_first = nil
    else
      add(ranges, value, value)
    end
  end
end

for line in prop_list:gmatch("[^\r\n]+") do
  local body = line:match("^([^#]*)") as string
  local first, last = body:match("^(%x+)%.%.(%x+)%s*;%s*White_Space")
  if not (first is nil) and not (last is nil) then
    add(
      whitespace, tonumber(first, 16) as integer, tonumber(last, 16) as integer
    )
  else
    local single = body:match("^(%x+)%s*;%s*White_Space")
    if not (single is nil) then
      local value = tonumber(single, 16) as integer
      add(whitespace, value, value)
    end
  end
end

local lines: {string} = {
  "-- Generated by scripts/gen_unicode.tl from Unicode "
    .. VERSION
    .. " general categories",
  "-- L, N and M plus the Unicode White_Space set.",
  "-- Rerun the generator rather than editing a range by hand.",
  "local record unicode",
  "  is_letter: function(integer): boolean",
  "  is_number: function(integer): boolean",
  "  is_mark: function(integer): boolean",
  "  is_whitespace: function(integer): boolean",
  "end",
  "",
}

local function emit(name: string, ranges: {integer})
  lines[#lines + 1] = "local " .. name .. ": {integer} = {"
  local row: {string} = {}
  for index = 1, #ranges do
    row[#row + 1] = string.format("0x%04X,", ranges[index])
    if #row == 8 then
      lines[#lines + 1] = "  " .. table.concat(row, " ")
      row = {}
    end
  end
  if #row > 0 then
    lines[#lines + 1] = "  " .. table.concat(row, " ")
  end
  lines[#lines + 1] = "}"
  lines[#lines + 1] = ""
end

emit("LETTER_RANGES", letters)
emit("NUMBER_RANGES", numbers)
emit("MARK_RANGES", marks)
emit("WHITESPACE_RANGES", whitespace)

local tail <const> = [=[local function within(
  ranges: {integer}, codepoint: integer
): boolean
  local low = 1
  local high = math.floor(#ranges / 2)
  while low <= high do
    local middle = math.floor((low + high) / 2)
    local first = ranges[middle * 2 - 1]
    local last = ranges[middle * 2]
    if codepoint < first then
      high = middle - 1
    elseif codepoint > last then
      low = middle + 1
    else
      return true
    end
  end
  return false
end

function unicode.is_letter(codepoint: integer): boolean
  return within(LETTER_RANGES, codepoint)
end

function unicode.is_number(codepoint: integer): boolean
  return within(NUMBER_RANGES, codepoint)
end

function unicode.is_mark(codepoint: integer): boolean
  return within(MARK_RANGES, codepoint)
end

function unicode.is_whitespace(codepoint: integer): boolean
  return within(WHITESPACE_RANGES, codepoint)
end

return unicode
]=]

for line in tail:gmatch("(.-)\n") do
  lines[#lines + 1] = line
end

fs.write(OUTPUT, table.concat(lines, "\n") .. "\n")
